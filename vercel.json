{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "realtime": {
      "root": "services/realtime",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/realtime(/.*)?",
      "destination": {
        "type": "service",
        "service": "realtime"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
