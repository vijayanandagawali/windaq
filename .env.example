# ===================================================
# WINDAQ — ENVIRONMENT CONFIGURATION (example values only)
# Never commit real secrets. Copy to .env and fill in.
# ===================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Local dev database created by "npm run db:local" (never point this at a real player database)
DATABASE_URL=postgresql://windaq:windaq_local@127.0.0.1:55432/windaq_dev
# Disposable database for automated tests (wiped on every run)
DATABASE_URL_TEST=postgresql://windaq:windaq_local@127.0.0.1:55432/windaq_test
# Frontend origin allowed by the realtime service CORS policy
FRONTEND_URL=http://localhost:3000

# --- Security (REQUIRED — the realtime service refuses to start without it) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- SMS OTP (REQUIRED in production for login) ---
FAST2SMS_API_KEY=
# Development/test only: fixed OTP used instead of sending SMS. Ignored when NODE_ENV=production.
DEV_FIXED_OTP=

# --- Guest test mode (play-money accounts; never withdrawable) ---
# Enabled by default outside production; set to true to allow in production.
ENABLE_GUEST_MODE=

# --- Payments ---
# UPI ID shown to players for manual deposits. Deposits are disabled in the UI while empty.
NEXT_PUBLIC_MERCHANT_UPI_ID=
# Webhook HMAC secret for payment providers (min 32 chars). Webhooks are rejected while empty.
UPI_SECRET_KEY=
# Allow the MOCK_UPI webhook in production (never enable on a real-money deployment).
ENABLE_MOCK_PAYMENTS=

# --- Frontend -> backend wiring ---
# Server-side URL the Next.js /api proxy forwards to
REALTIME_URL=http://localhost:4000
# Browser-side Socket.io URL (must point at the persistent realtime host in production)
NEXT_PUBLIC_WS_URL=

# --- Sports data (optional) ---
CRIC_API_KEY=
ODDS_API_KEY=
SPORTS_PROVIDER=INTERNAL_SIMULATOR
